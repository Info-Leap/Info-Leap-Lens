# InfoLeap Pulse — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── LLM Routing (OpenRouter) ─────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_PRO=openai/gpt-4o-mini
OPENROUTER_MODEL_ALT=openai/gpt-4o-mini
OPENROUTER_MODEL_MINI=openai/gpt-4o-mini
OPENROUTER_MODEL_LLAMA=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_NANO=qwen/qwen3.5-flash-02-23

# ── Narrative AI (Google Gemini) ─────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Google Cloud + Firebase ──────────────────────────────────────────────────
# GCP project created by setup_gcp.sh
FIREBASE_PROJECT_ID=infoleap-pulse

# From Firebase Console > Project Settings > General > Your apps > Web API Key
FIREBASE_WEB_API_KEY=AIza...

# Path to service account JSON (output of setup_gcp.sh step 7)
GOOGLE_APPLICATION_CREDENTIALS=oxdata/config/infoleap_service_account.json

# ── Google Drive Backend ─────────────────────────────────────────────────────
# ID of the Shared Drive root folder (InfoLeap Pulse Projects)
# Share that folder with the service account email as Editor
GDRIVE_ROOT_FOLDER_ID=1...

# Existing Sheets audit log (carry over from ox-db-project)
SHEETS_LOG_ID=1X_1cxiTeW5cdBzvjGiJzLvPBaNkYR-8AoqqwAnsqXdg

# ── Auth ─────────────────────────────────────────────────────────────────────
# Set to 1 in production to require Firebase login
# Leave at 0 for local development
INFOLEAP_AUTH_ENABLED=0
